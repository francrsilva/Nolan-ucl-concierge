# ── LLM provider ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# Reasoning model used by the text agent runtime (function calling).
AGENT_MODEL=gpt-4o

# Embedding model for the hybrid RAG vector leg. Leave blank to run
# RAG in keyword-only (BM25) mode with no network calls.
EMBEDDING_MODEL=text-embedding-3-small

# Realtime voice model (OpenAI Realtime API, GA). Used by /voice/session.
REALTIME_MODEL=gpt-realtime

# ── Server ───────────────────────────────────────────────────
PORT=8787
